{
  "manifest_version": 3,
  "name": "Autowriter",
  "version": "1.1.0",
  "author": "Kuzuw",
  "homepage_url": "https://github.com/Kuzuw/autowriter",
  "description": "Kopyaladığın metni seçtiğin alana insan gibi yazar: değişken hız, gerçekçi yazım hataları ve düzeltmeler.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "clipboardRead"
  ],
  "action": {
    "default_title": "Autowriter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "engine.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "start-typing": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Panodaki metni odaktaki alana insan gibi yaz (çalışırken tekrar basınca durdurur)"
    }
  }
}
